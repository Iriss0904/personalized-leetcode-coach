# --- dependencies ---
node_modules/
.pnp
.pnp.js

# --- Next.js build output ---
.next/
out/
build/
dist/

# --- environment (keep .env.example tracked) ---
.env
.env.local
.env*.local

# --- Prisma / SQLite local DB (WAL mode) ---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# --- local Piston runtime volume ---
piston/data/

# --- test artifacts / coverage / e2e reports ---
/coverage/
playwright-report/
test-results/
.nyc_output/

# --- generated eval run outputs (regenerable; do not commit) ---
evals/reports/

# --- logs (keep the dir, ignore its contents) ---
logs/*
!logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- editor / OS ---
.vscode/
.DS_Store
*.tsbuildinfo
*:Zone.Identifier

# --- personal notes (tracked by default) ---
# Uncomment the next line to keep interview-prep notes out of git:
# notes/
.superpowers/

# --- local PatternCoach operations / learner-data exports ---
.mcp.json
backups/
artifacts/memory-repair/

# Source-only publication: keep local documents, secrets, stores and exports out.
*.md
*.mdx
*.markdown
*.MD
*.db*
*.sqlite*
*.dump
*.backup*
*.sql.gz
.env*
!.env.example
.agents/
.claude/
.mcp.json
*.code-workspace
/docs/*
!/docs/assets/
/docs/assets/*
memory-bank/
notes/
interview/
artifacts/
evals/tmp/
evals/datasets/chat-intent-v3/real-user-queries-v1.json
evals/datasets/tool-governance/real-user-complex-seed-v1.json

# Public project showcase: preserve the README and its reviewed demo assets.
!/README.md
!/docs/assets/agent-trace.png
!/docs/assets/demo.gif
!/docs/assets/flashcard.png
!/docs/assets/handbook-export.png
!/docs/assets/handbook.png
